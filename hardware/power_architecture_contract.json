    "efuse_uvov_ladder_ohm": [470000, 11000, 47000],
    "efuse_dvdt_cap_f": 3.3e-9,
    "efuse_itimer_cap_f": 2.2e-9,
    "buck_frequency_hz": 1000000,
    "buck_feedback_ohm": [40200,10000],
    "buck_output_nominal_cap_f": 4.4e-5,
    "ldo_input_output_cap_f": 1e-6,
    "footprint_audit_blockers": ["TPS259470A_RPW10", "TPSM33625_RDN11"],
    "placement_in_scope": false,
