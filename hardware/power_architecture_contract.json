  "input": {
    "nominal_v": 12.0,
    "allowed_v": [10.8, 13.2],
    "recommended_external_supply": "12 V / 5 A certified external PSU",
    "connector_mpn": "1757242",
    "connector_family": "Phoenix Contact MSTBA 2,5/2-G-5,08",
    "input_net": "12V_IN_RAW"
  },
  "host_power": {
    "preferred_method_for_nfb": "VIN_7_TO_24V",
    "uno_q_pad": 8,
    "host_net": "12V_HOST_VIN",
    "usb_c_can_coexist": true,
    "official_supported_inputs": [
      "USB-C 5 V / up to 3 A",
      "VIN 7-24 V",
      "regulated 5 V through JANALOG 5 V pin / up to 3 A"
    ],
    "source_note": "Official Arduino GitHub docs-content confirms VIN is buck-converted to 5 V and diode-OR'd with USB-C into 5V_SYS. The regulated JANALOG 5 V pin is also a supported host power input.",
    "nfb_architecture_decisions": [
      "Use protected 12 V into VIN as the baseline host-power method.",
      "Do not tie shield-local 5V_RAIL to UNO Q 5 V in the baseline.",
      "Do not tie shield-local 3V3_RAIL to UNO Q PWR_3P3V in the baseline.",
      "Never drive IOREF; use it only as a high-impedance host-ready/reference signal."
    ]
  },
  "input_protection": {
    "efuse": {
      "ref": "U_EFUSE",
      "mpn": "TPS259470ARPWR",
      "vin_range_v": [2.7, 23.0],
      "current_capability_a": 5.5,
      "target_current_limit_a": 4.5,
      "production_rilm_ohm": 750,
      "production_ilim_typ_a": 4.452,
      "uvov_ladder_ohm": [470000, 11000, 47000],
      "production_dvdt_cap_f": 3.3e-9,
      "production_itimer_cap_f": 2.2e-9,
      "features": ["reverse_polarity", "true_reverse_current_blocking", "overcurrent", "overvoltage", "soft_start", "thermal_shutdown"]
    },
    "tvs": {
      "ref": "D_IN_TVS",
      "family": "SMBJ15A",
      "mpn": "SMBJ15A-TR",
      "vrwm_v": 15.0,
      "placement": "at input connector before eFuse"
    },
    "bulk_cap": {
      "ref": "C_IN_BULK",
      "mpn": "EEEFK1E101P",
      "value": "100 uF / 25 V",
      "placement": "after eFuse at star split"
    }
  },
  "star_split": {
    "source": "12V_PROTECTED",
    "branches": [
      {"net": "12V_HOST_VIN", "purpose": "Arduino UNO Q VIN", "continuous_budget_a": 1.5},
      {"net": "12V_LOGIC", "purpose": "shield low-voltage regulators", "continuous_budget_a": 1.0},
      {"net": "12V_ACT", "purpose": "pump + CO2 solenoid only", "continuous_budget_a": 1.5, "local_fuse_required": true, "fuse_mpn": "045401.5MR"}
    ],
    "chiller_power_on_pcba": false,
    "chiller_interface": "control signal only"
  },
  "shield_5v": {
    "net": "5V_RAIL",
    "host_5v_tied": false,
    "regulator": {
      "ref": "U_5V",
      "mpn": "TPSM33625RDNR",
      "type": "2.5A synchronous buck power module",
      "vin_range_v": [3.0, 36.0],
      "vout_v": 5.0,
      "rated_current_a": 2.5,
      "design_continuous_limit_a": 1.5,
      "switching_frequency_hz": 1000000,
      "feedback_ohm": [40200, 10000],
      "spread_spectrum": true,
      "emi_note": "CISPR 11 Class B compliant-capable with appropriate layout/filtering; final integrated product requires pre-compliance."
    },
    "enable": {
      "source": "UNO_IOREF_3V3",
      "uno_q_pad": 2,
      "pulldown_ref": "R_5V_EN_PD",
      "pulldown_ohm": 100000,
      "purpose": "keep shield 5V off until UNO Q IOREF is alive"
    },
    "power_good_net": "5V_PGOOD",
    "loads": ["pH module", "ORP module", "DO module", "HMI", "3.3V LDO input"]
  },
  "shield_3v3": {
    "net": "3V3_RAIL",
    "host_3v3_tied": false,
    "regulator": {
      "ref": "U_3V3",
      "mpn": "TLV75533PDBVR",
      "type": "500mA high-PSRR LDO",
      "vin_v": 5.0,
      "vout_v": 3.3,
      "rated_current_a": 0.5,
      "design_continuous_limit_a": 0.25,
      "enable_source": "5V_PGOOD",
      "input_cap_f": 1e-6,
      "output_cap_f": 1e-6
    },
    "loads": ["MPR pressure", "DS18B20", "HX711", "DFR1103", "I2C pullups", "TXU0202 VCCA", "watchdog", "ESD/support logic"],
    "reason": "preserve independent sequenced shield power domain and avoid accidental back-feed"
  },
  "power_sequence": [
    "12V_IN_RAW -> TVS/eFuse -> 12V_PROTECTED",
    "12V_PROTECTED -> J_UNOQ VIN; UNO Q boots from its own power tree",
    "UNO Q IOREF rises to 3.3 V -> enable U_5V",
    "U_5V PGOOD -> enable U_3V3",
    "Only then are shield field sensors/HMI and 3.3V logic energized"
  ],
  "power_budget": {
    "host_branch_w_design": 18.0,
    "shield_5v_w_design": 7.5,
    "actuator_12v_w_design": 18.0,
    "total_w_design": 43.5,
    "recommended_supply_w": 60.0,
    "note": "60 W adapter leaves margin; chiller power is external."
  },
  "actuator_policy": {
    "pump_peak_a_assumption": 0.8,
    "co2_solenoid_peak_a_assumption": 0.25,
    "local_branch_design_a": 1.5,
    "chiller": "external power; control only",
    "dirty_return_rule": "12V_ACT returns must join GND at power-entry/star region and must not cross Z1/Z2 return paths"
