  (text "J_UNOQ SENSOR ENDPOINTS\nA0 / pad 9 = PH_ADC\nA1 / pad 10 = ORP_ADC\nA2-D16 / pad 11 = TEMP_1WIRE\nA4 / pad 13 = DNP_RESERVE — A4/CO2_ADC DNP\nA5 / pad 14 = DO_ADC\nD20 / pad 31 = I2C_SDA\nD21 / pad 32 = I2C_SCL\nPOWER PR9: pad 4 +3V3 OUT y pad 5 +5V no alimentan rails locales del shield."
